# Server-side only. These values are placeholders and contain no credentials.
OPENAI_API_KEY=
TUSHARE_TOKEN=

# The Phase 1D provider combination uses public endpoints and does not consume
# the two values above. Keep them empty unless a later, separately approved
# service needs them.
STOCK_PROVIDER=

# Stock Gateway LAN deployment defaults.
STOCK_GATEWAY_PORT=8000
STOCK_GATEWAY_PUBLIC_HOSTNAME=TerrenceNAS
# Docker named volume by default; a bind path may be used after assigning it
# to UID 10001 (the non-root gateway user) on the NAS.
STOCK_GATEWAY_DATA_DIR=stock_gateway_data
STOCK_GATEWAY_QUOTE_TTL_SECONDS=5
STOCK_GATEWAY_INTRADAY_TTL_SECONDS=30
STOCK_GATEWAY_OFF_MARKET_REFRESH_SECONDS=300
STOCK_GATEWAY_STALE_SECONDS=300
STOCK_GATEWAY_PROVIDER_TIMEOUT_SECONDS=10
STOCK_GATEWAY_PROVIDER_RETRIES=1
STOCK_GATEWAY_PROVIDER_BACKOFF_SECONDS=0.25
